# Copie este archivo como .env y ajuste los valores.
DJANGO_SECRET_KEY=cambie-esta-clave-por-una-larga-y-aleatoria
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos: mysql (por defecto) o sqlite (solo para pruebas rápidas)
DB_ENGINE=mysql
DB_NAME=sysfood
DB_USER=sysfood
DB_PASSWORD=sysfood
DB_HOST=127.0.0.1
DB_PORT=3306

# HTTPS en producción: 1 activa redirección a HTTPS y cookies seguras
DJANGO_HTTPS=0

# Correo SMTP. Si EMAIL_HOST está vacío, los correos se muestran en la consola.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=SysFood <no-responder@sysfood.local>

# URL pública del sistema (se usa en los enlaces de los correos)
SITE_URL=http://127.0.0.1:8000

# Asistente de ayuda (opcional): modo con la API de Claude. Además ponga chat_modo = claude en Parámetros.
# ANTHROPIC_API_KEY=
# CHAT_CLAUDE_MODELO=claude-opus-5-5

# Canal de WhatsApp (opcional): meta o twilio. Vacío = apagado. Ver README, sección 3.4.
# WHATSAPP_PROVEEDOR=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# TWILIO_AUTH_TOKEN=
